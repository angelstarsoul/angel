{
  "version": "0.2.0",
  "configurations": [
    
    {
      "name": "Debug: telemetry_check (good.txt)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/homework_05/telemetry_check",
      "args": ["${workspaceFolder}/homework_05/data/good.txt"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        { "text": "-enable-pretty-printing" }
      ]
    },
    {
      "name": "Debug: telemetry_check (bad file)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/debug/homework_05/telemetry_check",
      "args": ["${workspaceFolder}/homework_05/data/bad_missing_field.txt"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
        { "text": "-enable-pretty-printing" }
      ]
    }
  ]
}